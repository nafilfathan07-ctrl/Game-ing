--- !u!114 &1494767712
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1494767711}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9bfd6a20647a998409c1df7ddd30826f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  leftPortraitImage: {fileID: 1510295054}
  rightPortraitImage: {fileID: 1784144822}
  leftTextBubble: {fileID: 235893042}
  leftNameText: {fileID: 659306179}
  leftDialogueText: {fileID: 797178918}
  rightTextBubble: {fileID: 106578055}
  rightNameText: {fileID: 811802917}
  rightDialogueText: {fileID: 323182751}
  centerTextBubble: {fileID: 0}
  centerNameText: {fileID: 0}
  centerDialogueText: {fileID: 0}
  typingSpeed: 0.03
  dimTransitionSpeed: 6
  inactiveBrightness: 0.55
  activeScale: {x: 1.1, y: 1.1, z: 1}
  inactiveScale: {x: 0.9, y: 0.9, z: 1}
  lines:
  - speakerName: Mentor
    text: '"Koneksi stabil. Saluran audio terenkripsi. Apa kau bisa mendengarku dari
      titik pantau itu?"'
    activeSpeaker: 1
    portraitOverride: {fileID: 0}
  - speakerName: MC
    text: '"Suara Bapak terdengar jelas. Aku sedang melihat ke arah rumah Richard
      sekarang. Kondisinya sepi."'
    activeSpeaker: 0
    portraitOverride: {fileID: 0}
  - speakerName: Mentor
    text: '"Bagus. Polisi baru saja pergi, tapi mereka akan kembali besok pagi dengan
      tim forensik penuh. Kita harus bergerak lebih dulu."'
    activeSpeaker: 1
    portraitOverride: {fileID: 0}
  - speakerName: Mentor
    text: '"Laporan resmi menyebutkan bahwa Richard tewas karena serangan jantung
      di ruang kerjanya. Tapi klien kita tidak percaya omong kosong itu."'
    activeSpeaker: 1
    portraitOverride: {fileID: 0}
  - speakerName: MC
    text: '"Serangan jantung mendadak? Untuk ukuran miliarder teknologi yang selalu
      dimonitor kesehatannya secara digital? Sangat mencurigakan."'
    activeSpeaker: 0
    portraitOverride: {fileID: 0}
  - speakerName: Mentor
    text: '"Tepat. Richard punya banyak musuh. Bahkan orang kepercayaannya, Anton,
      memiliki motif. Tugasmu adalah masuk ke ruang kerja itu dan meretas komputernya."'
    activeSpeaker: 1
    portraitOverride: {fileID: 0}
  - speakerName: MC
    text: '"Ada petunjuk spesifik dari mana aku harus memulai pencarian?"'
    activeSpeaker: 0
    portraitOverride: {fileID: 0}
  - speakerName: Mentor
    text: '"Menurut data intelijen kita, file terakhir yang ada di sistemnya bernama
      ''surat_wasiat.pdf''. Jangan langsung percaya pada nama file atau ekstensi
      yang terlihat."'
    activeSpeaker: 1
    portraitOverride: {fileID: 0}
  - speakerName: Mentor
    text: '"Gunakan ilmu investigasi terminal yang sudah kuajarkan padamu. Ekstrak
      metadata, periksa log modifikasi, dan jangan terkecoh alibi palsu."'
    activeSpeaker: 1
    portraitOverride: {fileID: 0}
  - speakerName: MC
    text: '"Paham. Aku tidak akan mengecewakan Bapak. Waktu kita terus berjalan,
      aku akan menyusup masuk ke dalam sekarang."'
    activeSpeaker: 0
    portraitOverride: {fileID: 0}
  - speakerName: Mentor
    text: '"Semoga berhasil. Perhatikan langkahmu, dan klik bangunan rumah itu saat
      kau sudah siap untuk masuk ke tahap investigasi."'
    activeSpeaker: 1
    portraitOverride: {fileID: 0}
  vnManager: {fileID: 1908391310}
